<?php
// Plantilla de components/conexion.local.php — el archivo real NO se
// commitea (está en .gitignore). En el despliegue de cPanel lo genera el
// workflow de GitHub Actions (.github/workflows/deploy.yml) a partir de los
// secrets del repo, sustituyendo estos placeholders por los valores reales.
//
// Si alguna vez necesitas probar el modo demo en local, copia este archivo
// como components/conexion.local.php y rellena tus propios valores.

putenv('DB_HOST=localhost');
putenv('DB_USER=usuario_cpanel_bd');
putenv('DB_PASS=contraseña_bd');
putenv('DB_NAME=usuario_cpanel_restaurante');

// Prefijo de la URL bajo el que vive la app en este hosting. Vacío si se
// sirve en la raíz del dominio.
putenv('APP_BASE_PATH=/restaurante');

define('DEMO_MODE', true);

// Token para forzar un reinicio manual de la demo visitando
// demo/reset_demo.php?token=... desde el navegador, sin acceso a consola.
// Genera el tuyo (ej. `php -r "echo bin2hex(random_bytes(24));"`) y guárdalo
// también como secret DEMO_RESET_TOKEN en GitHub.
define('DEMO_RESET_TOKEN', 'cambia-esto-por-un-token-largo-y-aleatorio');
